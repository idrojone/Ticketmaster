        {
          "name": "Auth - Register (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"email\": \"sample@example.com\", \"password\": \"secret\" }" },
            "url": { "raw": "{{user_service_base_url}}/api/register", "host": ["{{user_service_base_url}}"], "path": ["api","register"] }
          },
          "response": []
        },
        {
          "name": "Auth - Login (POST)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"email\": \"sample@example.com\", \"password\": \"secret\" }" },
            "url": { "raw": "{{user_service_base_url}}/api/login", "host": ["{{user_service_base_url}}"], "path": ["api","login"] }
          },
          "response": []
