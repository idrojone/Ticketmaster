generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}


// User model
model User{
    id        String @id @map("_id") @default(auto()) @db.ObjectId
    status    UserStatus @default(ACCPTED)
    is_active Boolean @default(true)
    role      UserRole @default(USER)
    public_id String @unique
    username  String @unique
    password  String
    email     String @unique
    bio       String?
    image     String?
    followers     String[] @db.ObjectId
    followingUsers String[] @db.ObjectId
    favoriteConciertos String[] @db.ObjectId
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum UserRole {
    ADMIN
    EMPRESA
    USER
}

enum UserStatus {
    ACCPTED
    INACTIVE
    PENDING
    BANNED
}  

// Generos model
model Genero {
    id        String @id @map("_id") @default(auto()) @db.ObjectId
    slug      String @unique
    nombre    String @unique
    img       String?
    descripcion String?
    id_genero String @unique
    status    GeneroStatus @default(ACTIVE)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    conciertos Concierto[] @relation("GeneroConciertos")
}

enum GeneroStatus {
    ACTIVE
    PENDING
    INACTIVE
}

// Concierto model
model Concierto {
    id          String @id @map("_id") @default(auto()) @db.ObjectId
    slug        String @unique
    nombre      String @unique
    fecha       DateTime
    artista     String
    lugar       String
    ciudad      String
    descripcion String?
    latitud     Float?
    longitud    Float?
    precio      Float
    aforo       Int
    duracion    Int // duración en minutos
    imgArtista  String?
    imagenesShow String[]
    id_genero   String @db.ObjectId
    genero      Genero @relation("GeneroConciertos", fields: [id_genero], references: [id])
    likes       Int @default(0)
    comentarios String[] @db.ObjectId
    vendidos    Int @default(0)
    status      ConciertoStatus @default(PENDING)
    active      Boolean @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}


enum ConciertoStatus {
    ACCEPTED
    PENDING
    CANCELLED
    SOLD_OUT
}