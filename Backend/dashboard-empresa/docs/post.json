{
  "info": {
    "name": "Auth Service - Ticketmaster (local)",
    "_postman_id": "ticketmaster-auth-local-collection",
    "description": "Colección para probar endpoints de Auth Service (register, login, profile, logout). Asegúrate de que el servicio corra en http://localhost:3031",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3031",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Hello (status)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"juan\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"secret123\",\n  \"bio\": \"Usuario de prueba\",\n  \"image\": \"https://example.com/avatar.png\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200,201]);",
              "});",
              "",
              "try {",
              "  const json = pm.response.json();",
              "  if (json && json.tokens && json.tokens.accessToken) {",
              "    pm.environment.set('accessToken', json.tokens.accessToken);",
              "    console.log('accessToken set');",
              "  } else {",
              "    console.log('No tokens in response');",
              "  }",
              "} catch (e) {",
              "  console.log('Response is not JSON or parse failed', e);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json && json.tokens && json.tokens.accessToken) {",
              "  pm.environment.set('accessToken', json.tokens.accessToken);",
              "  console.log('accessToken set from login');",
              "} else {",
              "  console.warn('No accessToken found in login response');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Profile (protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "profile"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Logout (protected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "});",
              "",
              "// unset stored token after logout",
              "pm.environment.unset('accessToken');",
              "console.log('accessToken unset after logout');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    }
  ]
}