/** 
*   Generos Model
*/

model Genero {
  id          String      @id @map("_id") @default(auto()) @db.ObjectId
  slug        String      @unique
  name        String      @unique
  img         String?
  description String?
  id_genero   String?     @unique

  // Relación uno a muchos con Concierto
  Conciertos  Concierto[]

  status      Status      @default(ACCEPTED)
  is_active   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("generos")
}

/** 
*   Concierto Model
*/

model Concierto {
    id String @id @map("_id") @default(auto()) @db.ObjectId
    slug String @unique
    nombre String
    fecha DateTime
    artista String
    lugar String
    ciudad String
    descripcion String?
    latitud Float?
    longitud Float?
    precio Float
    aforo Int
    duracion Int? /** Duración en minutos */
    imagenArtista String?
    imagenesShow String[] @default([])

    /* Relaciones de conciertos (https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/one-to-many-relations) One-to-many relations self relations */
    id_genero String
    genero Genero @relation(fields: [id_genero], references: [id_genero])

    /* Relación de likes con usuarios Many To Many */
    likedBy User[] @relation("UserLikes", fields: [likedByIDs], references: [id])
    likedByIDs String[] @db.ObjectId

    /* Relación de entradas One To Many */
    entradas Entrada[]

    /* Relación con Comentarios */
    comentarios Comentario[]

    status Status @default(ACCEPTED)
    is_active Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("conciertos")
}

/** 
*   Entradas Model
*/

enum TipoEntrada {
    GENERAL
    VIP
    PREMIUM
}

model Entrada {
    id String @id @map("_id") @default(auto()) @db.ObjectId
    /* Relacion con Usuario */
    userId String @db.ObjectId
    user User @relation(fields: [userId], references: [id])

    /* Relacion con Concierto */
    conciertoId String @db.ObjectId
    concierto Concierto @relation(fields: [conciertoId], references: [id])

    tipo TipoEntrada @default(GENERAL)
    cantidad Int @default(1)
    precio_compra Float
    fecha_compra DateTime @default(now())
    status Status @default(ACCEPTED)
    is_active Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("entradas")
}

/** 
*   Comentarios Model
*/

model Comentario {
    id String @id @map("_id") @default(auto()) @db.ObjectId

    /* Relacion con Usuarios*/
    userId String @db.ObjectId
    user User @relation(fields: [userId], references: [id])

    /* Relacion con Conciertos */
    conciertoId String @db.ObjectId
    concierto Concierto @relation(fields: [conciertoId], references: [id])

    contenido String
    status Status @default(ACCEPTED)
    is_active Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("comentarios")
}

/** 
*   RefreshTokenStore Model
*/

model RefreshTokenStore {
    id String @id @map("_id") @default(auto()) @db.ObjectId
    user User @relation(fields: [userId], references: [id])
    userId String @unique @db.ObjectId
    refreshToken String
    status Status @default(ACCEPTED)
    is_active Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("refresh_token_stores")
}

/** 
*   BlackListToken Model
*/
model BlackListToken {
    id String @id @map("_id") @default(auto()) @db.ObjectId
    userId String @db.ObjectId
    user User @relation(fields: [userId], references: [id])
    token String
    status Status @default(ACCEPTED)
    is_active Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@map("blacklist_tokens")
}