    HECHO !!!!!
    - Relaciones de Likes entre Usuario y Concierto
    - Relaciones de Seguidores entre Usuarios (self relation)
    - Modelo de RefreshTokenStore
    - Modelo de BlackListToken
    - Relaciones Entradas con Usuario y Concierto
    - Relaciones Comentarios con Usuario y Concierto
*/

/**
*   Status Enum para todas las tablas
*/ 
enum Status {
    PENDING
    ACCEPTED
    REJECTED
}


/** 
*   User Model
*/
model User {
    id  String @id @map("_id") @default(auto()) @db.ObjectId
    status Status @default(ACCEPTED)
    is_active Boolean @default(true)
    role String @default("USER")
    username String @unique
    email String @unique
    password String
    bio String?
    image String?

    /* Relacion de tokens */
    refreshToken RefreshTokenStore? // Relación uno a uno con RefreshTokenStore
    blackListTokens BlackListToken[] // Relación uno a muchos con BlackListToken

    /* Relaciones de seguimiento (https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/self-relations) Many-to-many self relations */
    followedBy User[] @relation("UserFollows", fields: [followedByIDs], references: [id])
    followedByIDs String[] @db.ObjectId
    follows User[] @relation("UserFollows", fields: [followsIDs], references: [id])
    followsIDs String[] @db.ObjectId

    /* Relacion de likes */
    likedConciertos Concierto[] @relation("UserLikes", fields: [likedConciertosIDs], references: [id])
    likedConciertosIDs String[] @db.ObjectId

    /* Relación con entradas */
    entradas Entrada[]

    /* Relación con Comentarios */
    comentarios Comentario[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

enum UserRole {
    ADMIN
    USER
    EMPRESA
}

