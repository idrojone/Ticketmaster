generator fastify {
    provider = "prisma-client-js"
    output   = "../DashboardAdmin/node_modules/.prisma/client"
}

generator nestjs {
    provider = "prisma-client-js"
    output   = "../dashboard-empresa/node_modules/.prisma/client"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

/**
 * TABLAS NUEVAS !!!!
 * - UserEmpresa, Entrada, Venta, Merchandaising, Pagos
 */

/**
 * Status Enum para todas las tablas
 */

enum Status {
    PENDING
    ACCEPTED
    REJECTED
    CANCELLED
}

enum OrderStatus {
    PENDING
    PAID
    FAILED
}

enum PaymentStatus {
    PENDING
    COMPLETED
}

/**
 * User Model
 */
model User {
    id        String  @id @default(auto()) @map("_id") @db.ObjectId
    status    Status  @default(ACCEPTED)
    is_active Boolean @default(true)
    role      String  @default("USER")
    username  String  @unique
    email     String  @unique
    password  String
    bio       String?
    image     String?

    /**
     * Relacion de tokens
     */
    refreshToken    RefreshTokenStore? // Relación uno a uno con RefreshTokenStore
    blackListTokens BlackListToken[] // Relación uno a muchos con BlackListToken

    /**
     * Relaciones de seguimiento (https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/self-relations) Many-to-many self relations
     */
    followedBy    User[]   @relation("UserFollows", fields: [followedByIDs], references: [id])
    followedByIDs String[] @db.ObjectId
    follows       User[]   @relation("UserFollows", fields: [followsIDs], references: [id])
    followsIDs    String[] @db.ObjectId

    /**
     * Relacion de likes
     */
    likedConciertos    Concierto[] @relation("UserLikes", fields: [likedConciertosIDs], references: [id])
    likedConciertosIDs String[]    @db.ObjectId

    /**
     * Relación con entradas
     */
    entradas Entrada[]

    /**
     * Relación con ventas
     */
    orders Order[]

    /**
     * Relación con Comentarios
     */
    comentarios Comentario[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    carritos  Carrito[]

    @@map("users")
}

enum UserRole {
    ADMIN
    USER
    EMPRESA
}

/**
 * UserAdmin Model
 */

model UserAdmin {
    id        String  @id @default(auto()) @map("_id") @db.ObjectId
    status    Status  @default(ACCEPTED)
    is_active Boolean @default(true)
    username  String  @unique
    email     String  @unique
    password  String
    bio       String?
    image     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user_admins")
}

model UserEmpresa {
    id        String  @id @default(auto()) @map("_id") @db.ObjectId
    status    Status  @default(ACCEPTED)
    is_active Boolean @default(true)
    username  String  @unique
    email     String  @unique
    password  String
    bio       String?
    image     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user_empresas")
}

/**
 * Artistas  Model
 */

/**
 * Ponemos artistas?
 * Ejemplo de referencia de tabla SQL:
 * CREATE TABLE artists (
 * id CHAR(36) PRIMARY KEY,
 * name VARCHAR(100) NOT NULL,
 * genre VARCHAR(50),
 * country VARCHAR(50),
 * description TEXT,
 * created_at DATETIME DEFAULT CURRENT_TIMESTAMP
 * );
 */

/**
 * Lugares Model
 */

/**
 * Ejemplo de referencia de tabla SQL:
 * CREATE TABLE venues (
 * id CHAR(36) PRIMARY KEY,
 * name VARCHAR(100) NOT NULL,
 * city VARCHAR(100),
 * country VARCHAR(100),
 * capacity INT NOT NULL,
 * created_at DATETIME DEFAULT CURRENT_TIMESTAMP
 * );
 */

/**
 * Generos Model
 */

model Genero {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    slug        String  @unique
    name        String  @unique
    img         String?
    description String?
    id_genero   String? @unique

    // Relación uno a muchos con Concierto
    Conciertos Concierto[]

    status    Status   @default(ACCEPTED)
    is_active Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("generos")
}

/**
 * Concierto Model
 */

model Concierto {
    id            String   @id @default(auto()) @map("_id") @db.ObjectId
    slug          String   @unique
    nombre        String
    fecha         DateTime
    artista       String
    lugar         String
    ciudad        String
    descripcion   String?
    latitud       Float?
    longitud      Float?
    precio        Float
    aforo         Int
    duracion      Int? /** Duración en minutos */
    imagenArtista String?
    imagenesShow  String[] @default([])

    /**
     * Relaciones de conciertos (https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/one-to-many-relations) One-to-many relations self relations
     */
    id_genero String
    genero    Genero @relation(fields: [id_genero], references: [id_genero])

    /**
     * Relación de likes con usuarios Many To Many
     */
    likedBy    User[]   @relation("UserLikes", fields: [likedByIDs], references: [id])
    likedByIDs String[] @db.ObjectId

    /**
     * Relación de entradas One To Many
     */
    entradas Entrada[]

    /**
     * Relación con Comentarios
     */
    comentarios Comentario[]

    /**
     * Relación con Merchandising (Many-to-Many)
     * NOTE: Se usa relación uno-a-muchos implícita desde Concierto hacia Merchandising.
     * Si hace falta muchos-a-muchos explícito, crear una tabla intermedia 'ConciertoMerchandising'.
     */
    merchandising   Merchandising? @relation("ConciertoMerchandising", fields: [merchandisingId], references: [id])
    merchandisingId String?        @db.ObjectId

    status    Status   @default(ACCEPTED)
    is_active Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    // carritos  Carrito[]

    @@map("conciertos")
}

/**
 * Entradas Model
 */

enum TipoEntrada {
    GENERAL
    VIP
    PREMIUM
}

model Entrada {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    /**
     * Relacion con Usuario
     */
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])

    /**
     * Relacion con Concierto
     */
    conciertoId String    @db.ObjectId
    concierto   Concierto @relation(fields: [conciertoId], references: [id])

    tipo          TipoEntrada @default(GENERAL)
    cantidad      Int         @default(1)
    precio_compra Float
    fecha_compra  DateTime    @default(now())
    status        Status      @default(ACCEPTED)
    is_active     Boolean     @default(true)
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt

    @@map("entradas")
}

model Merchandising {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    nombre      String
    descripcion String?
    precio      Float
    stock       Int
    imagen      String?

    /**
     * Relación con Conciertos (One-to-Many)
     * NOTE: Quitamos `fields` y `references` del lado lista para que sea la parte inversa de la relación.
     */
    conciertos   Concierto[] @relation("ConciertoMerchandising")
    conciertoIDs String[]    @db.ObjectId

    // categoriaID

    categoriaId String                 @db.ObjectId
    categoria   CategoriaMerchandising @relation(fields: [categoriaId], references: [id])

    status    Status   @default(ACCEPTED)
    is_active Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    // carritos  Carrito[]

    @@map("merchandising")
}

model Payment {
    id             String        @id @default(auto()) @map("_id") @db.ObjectId
    orderId        String        @db.ObjectId
    order          Order         @relation(fields: [orderId], references: [id])
    method         String
    amount         Float
    transactionRef String?
    currency       String?
    paidAt         DateTime?
    status         PaymentStatus @default(PENDING)
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@map("payments")
}

/**
 * Modelos Ventas, Merchandising, Pagos, CategoriasMerchandising
 */

model Order {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    /**
     * Relacion con Usuario
     */
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])

    // conciertoID, stock, merchandisingId

    carritoId String  @db.ObjectId
    carrito   Carrito @relation(fields: [carritoId], references: [id])

    conciertos    CarritoConcierto[]
    merchandising CarritoMerchandising[]

    /**
     * Relación con Pagos
     */
    payments Payment[]

    totalAmount Float
    status      OrderStatus @default(PENDING)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    @@map("orders")
}

model CategoriaMerchandising {
    id            String          @id @default(auto()) @map("_id") @db.ObjectId
    nombre        String          @unique
    descripcion   String?
    imagen        String?
    merchandising Merchandising[]
    status        Status          @default(ACCEPTED)
    is_active     Boolean         @default(true)
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt

    @@map("categorias_merchandising")
}

type CarritoConcierto {
    conciertoId String @db.ObjectId
    cantidad    Int    @default(1)
}

type CarritoMerchandising {
    merchandisingId String @db.ObjectId
    cantidad        Int    @default(1)
}

model Carrito {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])

    conciertos    CarritoConcierto[]
    merchandising CarritoMerchandising[]

    precio Float // redundante

    status    Status   @default(PENDING)
    is_active Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ventas    Order[]

    @@map("carritos")
}

/**
 * Comentarios Model
 */

model Comentario {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    /**
     * Relacion con Usuarios
     */
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])

    /**
     * Relacion con Conciertos
     */
    conciertoId String    @db.ObjectId
    concierto   Concierto @relation(fields: [conciertoId], references: [id])

    contenido String
    status    Status   @default(ACCEPTED)
    is_active Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("comentarios")
}

/**
 * RefreshTokenStore Model
 */

model RefreshTokenStore {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    user         User     @relation(fields: [userId], references: [id])
    userId       String   @unique @db.ObjectId
    refreshToken String
    status       Status   @default(ACCEPTED)
    is_active    Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@map("refresh_token_stores")
}

/**
 * BlackListToken Model
 */
model BlackListToken {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @db.ObjectId
    user      User     @relation(fields: [userId], references: [id])
    token     String
    status    Status   @default(ACCEPTED)
    is_active Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("blacklist_tokens")
}
